{
  "format": "rag.chunking-schema.v3",
  "document": {
    "document_id": "my-kb-en-extended",
    "language_code": "en",
    "display_name": "My KB EN Extended",
    "source_path": "/abs/path/to/source.md",
    "heading_patterns": {
      "h1_regex": "^# (?P<title>.+)$",
      "h2_regex": "^## (?P<title>.+)$",
      "h3_regex": "^### (?P<title>.+)$",
      "section_number_regex": "^(\\d{2})\\.\\s*"
    }
  },
  "io": {
    "output_root": "/abs/path/to/output-root",
    "overwrite_policy": "forbid",
    "chunk_meta": {
      "kind": "sqlite",
      "db_path": "app.db",
      "table": "chunk_meta",
      "language_code": "en"
    },
    "faiss_index_path": "faiss-en.index",
    "manifest_path": "manifest-en.json",
    "chunks_export_path": "chunks.jsonl",
    "protected_production_targets": {
      "chunk_meta_db_path": "/abs/path/to/prod/app.db",
      "faiss_index_path": "/abs/path/to/prod/faiss-en.index",
      "manifest_path": "/abs/path/to/prod/manifest-en.json",
      "require_explicit_override": true
    }
  },
  "categories": [
    {
      "id": "meta",
      "description": "Static policy chapters",
      "indexable": false,
      "allowed_in_static_prompt": true,
      "labels": {
        "section": "Section",
        "type": "Type",
        "source": "Source",
        "context": "Context",
        "question": "Question",
        "answer": "Answer"
      }
    },
    {
      "id": "sop",
      "description": "Main operational chapters",
      "indexable": true,
      "allowed_in_static_prompt": false,
      "labels": {
        "section": "Section",
        "type": "Type",
        "source": "Source",
        "context": "Context",
        "question": "Question",
        "answer": "Answer"
      }
    },
    {
      "id": "out_of_scope",
      "description": "Out-of-scope rules",
      "indexable": false,
      "allowed_in_static_prompt": true,
      "labels": {
        "section": "Section",
        "type": "Type",
        "source": "Source",
        "context": "Context",
        "question": "Question",
        "answer": "Answer"
      }
    },
    {
      "id": "faq",
      "description": "FAQ content",
      "indexable": true,
      "allowed_in_static_prompt": false,
      "labels": {
        "section": "Section",
        "type": "Type",
        "source": "Source",
        "context": "Context",
        "question": "Question",
        "answer": "Answer"
      }
    },
    {
      "id": "glossary",
      "description": "Glossary content",
      "indexable": false,
      "allowed_in_static_prompt": false,
      "labels": {
        "section": "Section",
        "type": "Type",
        "source": "Source",
        "context": "Context",
        "question": "Question",
        "answer": "Answer"
      }
    },
    {
      "id": "decision_tree",
      "description": "Decision tree content",
      "indexable": true,
      "allowed_in_static_prompt": false,
      "labels": {
        "section": "Section",
        "type": "Type",
        "source": "Source",
        "context": "Context",
        "question": "Question",
        "answer": "Answer"
      }
    },
    {
      "id": "scenario",
      "description": "Scenario content",
      "indexable": true,
      "allowed_in_static_prompt": false,
      "labels": {
        "section": "Section",
        "type": "Type",
        "source": "Source",
        "context": "Context",
        "question": "Question",
        "answer": "Answer"
      }
    },
    {
      "id": "reference",
      "description": "Reference appendix, optional for retrieval",
      "indexable": true,
      "allowed_in_static_prompt": false,
      "labels": {
        "section": "Section",
        "type": "Type",
        "source": "Source",
        "context": "Context",
        "question": "Question",
        "answer": "Answer"
      }
    }
  ],
  "default_category_id": "sop",
  "classification_rules": [
    {
      "id": "section-00-meta",
      "priority": 10,
      "target_category_id": "meta",
      "match": {
        "section_number_in": [
          "00"
        ]
      }
    },
    {
      "id": "section-13-out-of-scope",
      "priority": 20,
      "target_category_id": "out_of_scope",
      "match": {
        "section_number_in": [
          "13"
        ]
      }
    },
    {
      "id": "section-14-faq",
      "priority": 30,
      "target_category_id": "faq",
      "match": {
        "section_number_in": [
          "14"
        ]
      }
    },
    {
      "id": "section-15-glossary",
      "priority": 40,
      "target_category_id": "glossary",
      "match": {
        "section_number_in": [
          "15"
        ]
      }
    },
    {
      "id": "section-16-decision-tree",
      "priority": 50,
      "target_category_id": "decision_tree",
      "match": {
        "section_number_in": [
          "16"
        ]
      }
    },
    {
      "id": "section-17-scenario",
      "priority": 60,
      "target_category_id": "scenario",
      "match": {
        "section_number_in": [
          "17"
        ]
      }
    },
    {
      "id": "reference-by-title",
      "priority": 70,
      "target_category_id": "reference",
      "match": {
        "title_keywords_any": [
          "reference",
          "appendix",
          "terms of service"
        ]
      }
    }
  ],
  "chunking_policies": [
    {
      "id": "skip-whole-section",
      "strategy": "whole_section",
      "params": {
        "emit_chunks": false
      }
    },
    {
      "id": "sop-by-h2-with-h3-overflow",
      "strategy": "by_subheading",
      "params": {
        "heading_level": 2,
        "max_tokens": 800,
        "chars_per_token": 4,
        "overflow_split_level": 3,
        "include_parent_context": true,
        "overflow_strategy": "by_subheading",
        "overflow_overlap": 0
      }
    },
    {
      "id": "faq-qa-pairs",
      "strategy": "qa_pairs",
      "params": {
        "question_marker": "**Question:**",
        "answer_marker": "**Answer:**"
      }
    },
    {
      "id": "decision-tree-regex-split",
      "strategy": "regex_split",
      "params": {
        "split_regex": "^## (\\d+\\.\\d+\\..+)$",
        "title_capture_group": 1
      }
    },
    {
      "id": "scenario-regex-split",
      "strategy": "regex_split",
      "params": {
        "split_regex": "^## (Scenario \\d+:.+)$",
        "title_capture_group": 1
      }
    },
    {
      "id": "reference-token-window",
      "strategy": "token_window",
      "params": {
        "chunk_size": 700,
        "overlap": 120,
        "separators": [
          "\n\n",
          "\n",
          " "
        ]
      }
    }
  ],
  "category_policy_bindings": [
    {
      "category_id": "meta",
      "policy_id": "skip-whole-section"
    },
    {
      "category_id": "out_of_scope",
      "policy_id": "skip-whole-section"
    },
    {
      "category_id": "glossary",
      "policy_id": "skip-whole-section"
    },
    {
      "category_id": "sop",
      "policy_id": "sop-by-h2-with-h3-overflow",
      "extras": {
        "embedded_faq_block_regex": "\\n---\\s*\\n\\s*\\*\\*FAQ\\*\\*\\s*\\n",
        "embedded_faq_policy_id": "faq-qa-pairs",
        "embedded_faq_category_id": "faq"
      }
    },
    {
      "category_id": "faq",
      "policy_id": "faq-qa-pairs"
    },
    {
      "category_id": "decision_tree",
      "policy_id": "decision-tree-regex-split"
    },
    {
      "category_id": "scenario",
      "policy_id": "scenario-regex-split"
    },
    {
      "category_id": "reference",
      "policy_id": "reference-token-window"
    }
  ],
  "static_prompt": {
    "enabled": true,
    "blocks": [
      {
        "id": "chapter-00-project-description",
        "title": "Chapter 00 - Project description",
        "guidance_text": "Insert policy guidance here",
        "source": {
          "section_numbers": [
            "00"
          ]
        }
      },
      {
        "id": "chapter-13-out-of-scope",
        "title": "Chapter 13 - Out of Scope",
        "guidance_text": "Insert out-of-scope policy guidance here",
        "source": {
          "section_numbers": [
            "13"
          ]
        }
      }
    ]
  },
  "retrieval_lanes": [
    {
      "id": "sop",
      "label": "SOP",
      "description": "Operational SOP lane",
      "allowed_category_ids": [
        "sop"
      ],
      "top_k": 8,
      "oversample": 10,
      "min_fetch": 80,
      "min_similarity": 0.3
    },
    {
      "id": "faq",
      "label": "FAQ",
      "description": "FAQ lane",
      "allowed_category_ids": [
        "faq"
      ],
      "top_k": 5,
      "oversample": 10,
      "min_fetch": 80,
      "min_similarity": 0.3
    },
    {
      "id": "decision_tree",
      "label": "Decision trees",
      "description": "Decision-tree lane",
      "allowed_category_ids": [
        "decision_tree"
      ],
      "top_k": 3,
      "oversample": 10,
      "min_fetch": 80,
      "min_similarity": 0.3,
      "presentation": {
        "ui_priority": 100,
        "ui_variant": "decision_tree",
        "exclude_from_generation_context": true,
        "verification_strategy": "dedicated_llm",
        "verification_no_match_token": "NO_DECISION_TREE_MATCH",
        "max_verification_candidates": 1
      }
    },
    {
      "id": "scenario",
      "label": "Scenarios",
      "description": "Scenario lane",
      "allowed_category_ids": [
        "scenario"
      ],
      "top_k": 3,
      "oversample": 10,
      "min_fetch": 80,
      "min_similarity": 0.3
    },
    {
      "id": "reference",
      "label": "Reference",
      "description": "Reference lane",
      "allowed_category_ids": [
        "reference"
      ],
      "top_k": 4,
      "oversample": 10,
      "min_fetch": 80,
      "min_similarity": 0.0
    }
  ]
}
